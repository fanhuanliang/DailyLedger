# Docker binds locally by default. Set BIND_IP to the VM's home-network IP for LAN use after firewall checks.
BIND_IP=127.0.0.1
APP_PORT=8095
HOST=127.0.0.1
PORT=5010
DB_PATH=./data/ledger.db
HOUSEHOLD_TIMEZONE=America/Los_Angeles
# The single origin browsers load the app from (proxy/dev origin). Browser writes are rejected unless
# their Origin header matches this value exactly. Local dev default matches the Vite dev server.
APP_ORIGIN=http://127.0.0.1:5173
# Set to true only when the app is served over HTTPS; otherwise browsers will refuse the session cookie.
COOKIE_SECURE=false
# Scoped bearer token for the MCP bridge. Required before connecting MCP; never commit a real token.
MCP_TOKEN=
